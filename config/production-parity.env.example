# Opt-in profile for testing the large-media limits recorded in docs/Server architecture.md.
# Keep test-site access controls and container resource limits enabled when using it.
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_MAX_FILESIZE=1024M
PHP_POST_MAX_SIZE=1024M
PHP_MAX_EXECUTION_TIME=180
NGINX_CLIENT_MAX_BODY_SIZE=1024m
