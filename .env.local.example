COMPOSE_PROJECT_NAME=wsf-local
ENVIRONMENT=local
WORDPRESS_ENVIRONMENT_TYPE=development
WORDPRESS_HOME=http://127.0.0.1:8080
WORDPRESS_SITEURL=http://127.0.0.1:8080
WORDPRESS_LOCALE=en_ZA
LOCAL_HTTP_PORT=8080
DB_NAME=wordpress
DB_USER=wordpress
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_520_ci
PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=64M
PHP_POST_MAX_SIZE=64M
PHP_MAX_EXECUTION_TIME=120
NGINX_CLIENT_MAX_BODY_SIZE=64m
WP_DEBUG=true
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=false
DISALLOW_FILE_EDIT=false
DISALLOW_FILE_MODS=false
APP_IMAGE_TAG=7.1.3-php8.3.36-local
SECRETS_DIR=./tests/fixtures/secrets
WP_ADMIN_USER=localadmin
WP_ADMIN_EMAIL=developer@example.invalid
WP_ADMIN_PASSWORD=local-development-only
WP_SITE_TITLE=We Sell Flavours Local
