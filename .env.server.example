# Copy to a root/deploy-owner-readable path outside Git and replace every value.
COMPOSE_PROJECT_NAME=wsf-test
ENVIRONMENT=staging
WORDPRESS_ENVIRONMENT_TYPE=staging
TEST_DOMAIN=test.example.invalid
WORDPRESS_HOME=https://test.example.invalid
WORDPRESS_SITEURL=https://test.example.invalid
WORDPRESS_LOCALE=en_ZA
TLS_EMAIL=operator@example.invalid
BASIC_AUTH_USER=tester
WP_ADMIN_USER=testadmin
WP_ADMIN_EMAIL=operator@example.invalid
WP_SITE_TITLE="We Sell Flavours Test"
DB_NAME=wordpress_test
DB_USER=wordpress_test
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_520_ci
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_MAX_FILESIZE=1000M
PHP_POST_MAX_SIZE=1024M
PHP_MAX_EXECUTION_TIME=900
PHP_MAX_INPUT_TIME=1200
NGINX_FASTCGI_READ_TIMEOUT=1200s
NGINX_CLIENT_MAX_BODY_SIZE=1024m
MARIADB_MEMORY_LIMIT=512m
MARIADB_CPUS=0.75
WORDPRESS_MEMORY_LIMIT=640m
WORDPRESS_CPUS=0.75
NGINX_MEMORY_LIMIT=128m
NGINX_CPUS=0.25
WP_DEBUG=false
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=false
DISALLOW_FILE_EDIT=false
DISALLOW_FILE_MODS=false
APP_IMAGE_TAG=7.1.3-php8.3.36-server
APP_IMAGE_TAG_BASE=7.1.3-php8.3.36
SECRETS_DIR=/etc/we-sell-flavours/secrets
BACKUP_DIR=/var/backups/we-sell-flavours
BACKUP_RETENTION_DAYS=14
BACKUP_REMOTE=
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY=/etc/we-sell-flavours/backup-age-identity.txt
ALERT_WEBHOOK_URL_FILE=/etc/we-sell-flavours/secrets/alert_webhook_url
DEPLOY_BRANCH=main
DEPLOY_DIR=/srv/we-sell-flavours
MIN_FREE_DISK_MB=4096
